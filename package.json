{
  "name": "timeforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "patch-package --error-on-fail && nuxt prepare",
    "test": "npm run test:node && npm run test:unit",
    "test:all": "npm test && npm run test:e2e",
    "test:node": "node --test tests/*.test.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:docker": "docker run --rm --init --ipc=host -v \"$PWD:$PWD\" -w \"$PWD\" mcr.microsoft.com/playwright:v1.64.1-noble npx playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@pinia/nuxt": "^0.5.5",
    "axios": "^1.20.0",
    "pinia": "^2.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "nuxt": "^3.21.11",
    "patch-package": "^8.0.1",
    "sass": "^1.105.1",
    "typescript": "^5.9.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.12",
    "vuetify": "^3.13.6"
  },
  "overrides": {
    "@nuxt/devtools": {
      ".": "3.4.2",
      "simple-git": "4.0.2"
    },
    "node-forge": "1.4.0"
  }
}
