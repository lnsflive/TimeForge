{
  "name": "timeforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --require ./scripts/synology-icu.cjs node_modules/nuxt/bin/nuxt.mjs build",
    "dev": "node --require ./scripts/synology-icu.cjs node_modules/nuxt/bin/nuxt.mjs dev",
    "generate": "node --require ./scripts/synology-icu.cjs node_modules/nuxt/bin/nuxt.mjs generate",
    "preview": "node --require ./scripts/synology-icu.cjs node_modules/nuxt/bin/nuxt.mjs preview",
    "postinstall": "node --require ./scripts/synology-icu.cjs node_modules/nuxt/bin/nuxt.mjs prepare",
    "test": "node --test tests/*.test.js",
    "deploy:preview": "node scripts/deploy.mjs",
    "deploy": "npm run generate && node scripts/deploy.mjs --apply"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@nuxtjs/strapi": "^1.10.1",
    "@pinia/nuxt": "^0.5.1",
    "axios": "^1.6.7",
    "dotenv": "^17.2.0",
    "pinia": "^2.1.7"
  },
  "devDependencies": {
    "@nuxt/devtools": "latest",
    "@nuxtjs/vuetify": "^1.12.3",
    "@types/axios": "^0.14.0",
    "@vite-pwa/nuxt": "^1.0.4",
    "nuxt": "^3.10.1",
    "sass": "^1.70.0",
    "vite-plugin-pwa": "^1.0.1",
    "vite-plugin-vuetify": "^2.1.1",
    "vuetify": "^3.9.0",
    "vuetify-nuxt-module": "^0.18.7"
  }
}
